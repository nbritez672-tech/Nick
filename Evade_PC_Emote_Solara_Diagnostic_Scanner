    local humAnim = hum and hum:FindFirstChildOfClass("Animator")
    local ac      = rig:FindFirstChildOfClass("AnimationController")
    local acAnim  = ac and ac:FindFirstChildOfClass("Animator")
    return humAnim, acAnim
end

--// PC/Solara fallback: Solara no expone getgc/hookfunction, por lo que no se
--// puede activar inEvadeEmote desde MovementStat.SpeedChange. El rig visual
--// confirmado sí expone GetPlayingAnimationTracks(); se usa como detector local.
--// No instala hooks ni depende de AnimationPlayed, que puede no dispararse si
--// el track ya estaba activo antes de conectar el listener.
local directEmoteDetectorConnection = nil
local directEmotePollAccumulator = 0
local DIRECT_EMOTE_END_GRACE = 0.25

local function isDirectActionTrack(track)
    if not track then return false end
    local animation = track.Animation
    local id = animation and animation.AnimationId
    if not id or IDLE_IDS[id] then return false end

    local priority = tostring(track.Priority)
    if not string.find(priority, "Action", 1, true) then
        return false
    end

    return track.IsPlaying == true
end

local function pollDirectEmoteTracks()
    if directSelectedIdx ~= EmoteState.emoteIdx then
        table.clear(directTrackSeen)
        table.clear(directTrackAttemptWarnings)
        directSelectedIdx = EmoteState.emoteIdx
    end

    if not EmoteState.enabled or not EmoteState.emoteIdx then
        inEvadeEmote = false
        table.clear(directTrackSeen)
        return
    end

    local humAnim, acAnim = getEmoteRigAnimators()
    local targets = {
        { animator = humAnim, label = "Humanoid.Animator" },
        { animator = acAnim, label = "AnimationController.Animator" },
    }
    local activeTracks = {}
    local hasRealActionTrack = false

    for _, target in ipairs(targets) do
        local animator = target.animator
        if animator then
            local tracks = pcall(function()
                return animator:GetPlayingAnimationTracks()
            end)
            local ok, playingTracks = pcall(function()
                return animator:GetPlayingAnimationTracks()
            end)
            if ok and playingTracks then
                for _, track in ipairs(playingTracks) do
                    activeTracks[track] = true
                    if isDirectActionTrack(track) then
                        local animation = track.Animation
                        local id = animation and animation.AnimationId
                        if id ~= (EMOTES[EmoteState.emoteIdx] and EMOTES[EmoteState.emoteIdx].animId) then
                            hasRealActionTrack = true
                            if not directTrackSeen[track] then
                                inEvadeEmote = true
                                local previousVisualTrack = activeVisualTrack
                                local selectedEmote = EMOTES[EmoteState.emoteIdx]
                                local callOk = pcall(function()
                                    directPreserveSourceTrack = true
                                    onEmoteAnimPlayed(animator, track)
                                end)
                                directPreserveSourceTrack = false

                                local visualCreated = activeVisualTrack ~= previousVisualTrack and activeVisualTrack ~= nil
                                local alreadyCorrect = selectedEmote and selectedEmote.animId == id
                                if callOk and (visualCreated or alreadyCorrect) then
                                    directTrackSeen[track] = true
                                else
                                    directTrackSeen[track] = nil
                                    if not directTrackAttemptWarnings[track] then
                                        directTrackAttemptWarnings[track] = true
                                        warn("[Emote PC fallback] Visual replacement attempt did not create a track; retrying")
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    for track in pairs(directTrackSeen) do
        if not activeTracks[track] then
            directTrackSeen[track] = nil
        end
    end

    if hasRealActionTrack then
        -- El track fuente sigue activo: el emote real continúa.
        directNoActionSince = nil
        inEvadeEmote = true
    elseif activeVisualTrack then
        -- El track fuente desapareció. La tolerancia evita falsos cortes durante
        -- el cambio de track que hace Evade al terminar el emote.
        if not directNoActionSince then
            directNoActionSince = os.clock()
        elseif os.clock() - directNoActionSince >= DIRECT_EMOTE_END_GRACE then
            cleanupActiveEmote()
            inEvadeEmote = false
            directNoActionSince = nil
            table.clear(directTrackSeen)
        end
    else
        directNoActionSince = nil
        inEvadeEmote = false
    end
end

local function startDirectEmoteDetector()
    if directEmoteDetectorConnection then return end
    directEmoteDetectorConnection = RunService.Heartbeat:Connect(function(deltaTime)
        directEmotePollAccumulator = directEmotePollAccumulator + deltaTime
        if directEmotePollAccumulator < 0.05 then return end
        directEmotePollAccumulator = 0
        pcall(pollDirectEmoteTracks)
    end)
end

