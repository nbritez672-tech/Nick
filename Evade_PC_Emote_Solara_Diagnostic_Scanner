--[[
    YIN YANG — PC/SOLARA DIAGNOSTIC SCANNER (SOLO LECTURA)
    No modifica nada. No usa getgc, hookfunction, getconnections
    ni AnimationPlayed:Connect. Solo lee propiedades por polling.

    Ejecutar ESTO en paralelo mientras el emote real de Evade está
    activo, durante 2-3 segundos. Copia el log al portapapeles y
    lo guarda con writefile.

    Qué busca:
      - Si el fake Animation sigue existiendo/parenteado con el tiempo
      - Si TimePosition del visual deja de avanzar (freeze real)
      - Si Speed/WeightCurrent cambian solos (interferencia externa)
      - Si aparecen tracks Action* nuevos no esperados (Evade re-syncing)
]]

local Players = game:GetService("Players")
local RS      = game:GetService("RunService")
local lp      = Players.LocalPlayer

local IDLE_IDS = {
    ["rbxassetid://17418770762"] = true, ["rbxassetid://17418484618"] = true,
    ["rbxassetid://17418691532"] = true, ["rbxassetid://17418712872"] = true,
    ["rbxassetid://17418485963"] = true, ["rbxassetid://17418788540"] = true,
    ["rbxassetid://17418483149"] = true, ["rbxassetid://17524391617"] = true,
}

local log = {}
local start = os.clock()
local function ts() return string.format("[%06.3fs]", os.clock() - start) end
local function add(s) log[#log+1] = s end

local rig = workspace:FindFirstChild("Rigs") and workspace.Rigs:FindFirstChild(lp.Name)
local hum = rig and rig:FindFirstChildOfClass("Humanoid")
local animator = hum and hum:FindFirstChildOfClass("Animator")

if not animator then
    add("ERROR: no se encontró Humanoid.Animator en el Rig visual")
    setclipboard(table.concat(log, "\n"))
    return
end

add("=== PC/SOLARA DIAG SCANNER ===")
add("Rig: " .. rig:GetFullName())
add("Animator: " .. animator:GetFullName())
add("")

-- Estado previo para detectar cambios, por track (usamos el objeto como key)
local lastState = {}

local function classify(track)
    local id = track.Animation and track.Animation.AnimationId
    if not id then return "UNKNOWN" end
    if IDLE_IDS[id] then return "IDLE_TRACK" end
    local pr = tostring(track.Priority)
    if pr:find("Action4") then return "VISUAL_TRACK_CANDIDATE" end -- nuestro visual usa Action4
    if pr:find("Action") then return "SOURCE_TRACK_CANDIDATE" end  -- el emote real suele ser Action3
    return "OTHER"
end

local elapsed = 0
local conn
conn = RS.Heartbeat:Connect(function(dt)
    elapsed = elapsed + dt
    if elapsed > 3 then
        conn:Disconnect()
        add("")
        add("=== FIN DEL SCAN (3s) ===")
        local full = table.concat(log, "\n")
        pcall(writefile, "yy_pc_diag_scan.txt", full)
        pcall(setclipboard, full)
        print("[DIAG] Guardado y copiado. Líneas: " .. #log)
        return
    end

    local ok, tracks = pcall(function() return animator:GetPlayingAnimationTracks() end)
    if not ok then return end

    for _, track in ipairs(tracks) do
        local kind = classify(track)
        local id = track.Animation and track.Animation.AnimationId or "nil"
        local animObj = track.Animation
        local animParented = animObj and animObj.Parent ~= nil

        local snapshot = {
            IsPlaying = track.IsPlaying,
            Speed     = track.Speed,
            TimePos   = track.TimePosition,
            Weight    = track.WeightCurrent,
            Priority  = tostring(track.Priority),
            Looped    = track.Looped,
        }

        local prev = lastState[track]
        local changed = {}
        if prev then
            for k, v in pairs(snapshot) do
                if prev[k] ~= v then
                    table.insert(changed, k .. ":" .. tostring(prev[k]) .. "->" .. tostring(v))
                end
            end
        end

        if kind ~= "IDLE_TRACK" then
            add(ts() .. " " .. kind
                .. " id=" .. id
                .. " playing=" .. tostring(snapshot.IsPlaying)
                .. " speed=" .. tostring(snapshot.Speed)
                .. " time=" .. string.format("%.2f", snapshot.TimePos)
                .. " weight=" .. string.format("%.2f", snapshot.Weight)
                .. " prio=" .. snapshot.Priority
                .. " looped=" .. tostring(snapshot.Looped)
                .. " animParented=" .. tostring(animParented))

            if #changed > 0 then
                add("    CHANGED: " .. table.concat(changed, ", "))
            end
        end

        lastState[track] = snapshot
    end
end)
