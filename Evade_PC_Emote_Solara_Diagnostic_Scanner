    layerJumpsInstance = nil
    originalJumpCap = nil
end)

local function applyLayerJumps()
    if not Config.EnableLayerJumps then
        if layerJumpsInstance and originalJumpCap then
            pcall(function()
                local ms = rawget(layerJumpsInstance, "MoveStats")
                if type(ms) == "table" then
