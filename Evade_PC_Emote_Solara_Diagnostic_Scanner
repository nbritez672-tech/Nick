--[[
    YIN YANG — PC/SOLARA DIAGNOSTIC SCANNER V3 (SOLO LECTURA)

    Esta versión espera hasta detectar el track fuente real antes de iniciar
    la ventana de diagnóstico. Así no importa si el usuario tarda algunos
    segundos en comenzar el emote después de ejecutar el scanner.

    Uso:
      1. Ejecutar una sola vez con la librería cargada.
      2. Iniciar inmediatamente o dentro de los siguientes 20 segundos el
         emote real de Evade.
      3. Mantenerlo activo al menos 6 segundos después de detectarlo.

    No reproduce, detiene, ajusta ni destruye nada.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local SOURCE_ID = "rbxassetid://113826325934853"
local VISUAL_IDS = {
    ["rbxassetid://111570274714712"] = true,
    ["rbxassetid://125497596837433"] = true,
    ["rbxassetid://84248734120911"] = true,
    ["rbxassetid://73383479205643"] = true,
    ["rbxassetid://119226805386886"] = true,
    ["rbxassetid://82579103193493"] = true,
    ["rbxassetid://76664554569994"] = true,
    ["rbxassetid://82698079573413"] = true,
    ["rbxassetid://118337616190939"] = true,
    ["rbxassetid://103095884226031"] = true,
    ["rbxassetid://126396646825215"] = true,
    ["rbxassetid://97074392214454"] = true,
    ["rbxassetid://113685905137377"] = true,
    ["rbxassetid://89805417778763"] = true,
    ["rbxassetid://112692937680187"] = true,
    ["rbxassetid://89755710041366"] = true,
}

local IDLE_IDS = {
    ["rbxassetid://17418770762"] = true,
    ["rbxassetid://17418484618"] = true,
    ["rbxassetid://17418691532"] = true,
    ["rbxassetid://17418712872"] = true,
    ["rbxassetid://17418485963"] = true,
    ["rbxassetid://17418788540"] = true,
    ["rbxassetid://17418483149"] = true,
    ["rbxassetid://17524391617"] = true,
}

local function fullName(instance)
    local ok, value = pcall(function()
        return instance and instance:GetFullName()
    end)
    return ok and value or "<unavailable>"
end

local function read(callback, fallback)
    local ok, value = pcall(callback)
    return ok and value or fallback
end

local function makeAnimators()
    local rigs = workspace:FindFirstChild("Rigs")
    local rig = rigs and rigs:FindFirstChild(LocalPlayer.Name)
    local result = {}
    local seen = {}

    local humanoid = rig and rig:FindFirstChildOfClass("Humanoid")
    local humAnimator = humanoid and humanoid:FindFirstChildOfClass("Animator")
    if humAnimator then
        result[#result + 1] = humAnimator
        seen[humAnimator] = true
    end

    local controller = rig and rig:FindFirstChildOfClass("AnimationController")
    local controllerAnimator = controller and controller:FindFirstChildOfClass("Animator")
    if controllerAnimator and not seen[controllerAnimator] then
        result[#result + 1] = controllerAnimator
    end

    return rig, result
end

local function getState(track, animator)
    local animation = read(function() return track.Animation end, nil)
    local id = read(function() return animation and animation.AnimationId end, "nil")
    local priority = tostring(read(function() return track.Priority end, "unknown"))
    local kind
    if id == SOURCE_ID then
        kind = "SOURCE_TRACK"
    elseif VISUAL_IDS[id] then
        kind = "VISUAL_TRACK"
    elseif IDLE_IDS[id] then
        kind = "IDLE_TRACK"
    elseif string.find(priority, "Action", 1, true) then
        kind = "OTHER_ACTION_TRACK"
    else
        kind = "OTHER_TRACK"
    end

    return {
        Track = track,
        Kind = kind,
        Id = id,
        Animator = fullName(animator),
        IsPlaying = read(function() return track.IsPlaying end, "error"),
        Speed = read(function() return track.Speed end, "error"),
        TimePosition = read(function() return track.TimePosition end, "error"),
        Length = read(function() return track.Length end, "error"),
        WeightCurrent = read(function() return track.WeightCurrent end, "error"),
        WeightTarget = read(function() return track.WeightTarget end, "unavailable"),
        Priority = priority,
        Looped = read(function() return track.Looped end, "error"),
        IsAnimationParented = animation ~= nil and read(function() return animation.Parent ~= nil end, false),
        AnimationParent = read(function() return animation and animation.Parent and animation.Parent:GetFullName() end, "nil"),
    }
end

local function number(value)
    if type(value) == "number" then
        return string.format("%.4f", value)
    end
    return tostring(value)
end

local function describe(state)
    return "kind=" .. tostring(state.Kind)
        .. " id=" .. tostring(state.Id)
        .. " playing=" .. tostring(state.IsPlaying)
        .. " speed=" .. number(state.Speed)
        .. " time=" .. number(state.TimePosition)
        .. " length=" .. number(state.Length)
        .. " weight=" .. number(state.WeightCurrent)
        .. " targetWeight=" .. tostring(state.WeightTarget)
        .. " prio=" .. tostring(state.Priority)
        .. " looped=" .. tostring(state.Looped)
        .. " animParented=" .. tostring(state.IsAnimationParented)
        .. " animParent=" .. tostring(state.AnimationParent)
        .. " animator=" .. tostring(state.Animator)
end

local log = {}
local function add(text)
    log[#log + 1] = text
end

local rig, animators = makeAnimators()
if not rig or #animators == 0 then
    add("ERROR: no se encontró el rig visual o ningún Animator")
    local result = table.concat(log, "\n")
    pcall(function() writefile("yy_pc_diag_scan_v3.txt", result) end)
    pcall(function() setclipboard(result) end)
    return
end

add("=== PC/SOLARA DIAG SCANNER V3 WAIT ===")
add("Rig: " .. fullName(rig))
for _, animator in ipairs(animators) do
    add("Animator: " .. fullName(animator))
end
add("SOURCE_ID=" .. SOURCE_ID)
add("WAIT_TIMEOUT=20s")
add("CAPTURE_AFTER_SOURCE=6s")
add("")
add("WAITING_FOR_SOURCE_TRACK")

local started = os.clock()
local captureStarted = nil
local sampleAccumulator = 0
local lastStates = {}
local previousTrackSet = {}
local sourceEverDetected = false
local conn

local function finish(reason)
    if conn then
        conn:Disconnect()
        conn = nil
    end
    add("")
    add("FINISH_REASON=" .. tostring(reason))
    add("=== FIN DEL SCAN V3 ===")
    local result = table.concat(log, "\n")
    pcall(function() writefile("yy_pc_diag_scan_v3.txt", result) end)
    pcall(function() setclipboard(result) end)
    print("[DIAG V3] Guardado y copiado. Líneas: " .. tostring(#log))
end

conn = RunService.Heartbeat:Connect(function(deltaTime)
    local now = os.clock()
    if not captureStarted and now - started >= 20 then
        finish("TIMEOUT_WITHOUT_SOURCE_TRACK")
        return
    end

    sampleAccumulator = sampleAccumulator + deltaTime
    if sampleAccumulator < 0.05 then return end
    sampleAccumulator = 0

    local currentTrackSet = {}
    local sourceDetectedThisSample = false

    for _, animator in ipairs(animators) do
        local ok, tracks = pcall(function()
            return animator:GetPlayingAnimationTracks()
        end)
        if ok and tracks then
            for _, track in ipairs(tracks) do
                currentTrackSet[track] = true
                local state = getState(track, animator)

                if state.Kind == "SOURCE_TRACK" and state.IsPlaying == true then
                    sourceDetectedThisSample = true
                    sourceEverDetected = true
                    if not captureStarted then
                        captureStarted = now
                        add(string.format("[%06.3fs] SOURCE_DETECTED; CAPTURE_STARTED", now - started))
                    end
                end

                local previous = lastStates[track]
                if not previous then
                    if state.Kind ~= "IDLE_TRACK" then
                        add(string.format("[%06.3fs] NEW_TRACK %s", now - started, describe(state)))
                    end
                else
                    local changes = {}
                    if previous.IsPlaying ~= state.IsPlaying then
                        changes[#changes + 1] = "IsPlaying=" .. tostring(previous.IsPlaying) .. "->" .. tostring(state.IsPlaying)
                    end
                    if previous.Speed ~= state.Speed then
                        changes[#changes + 1] = "Speed=" .. tostring(previous.Speed) .. "->" .. tostring(state.Speed)
                    end
                    if previous.WeightCurrent ~= state.WeightCurrent then
                        changes[#changes + 1] = "Weight=" .. tostring(previous.WeightCurrent) .. "->" .. tostring(state.WeightCurrent)
                    end
                    if previous.Priority ~= state.Priority then
                        changes[#changes + 1] = "Priority=" .. tostring(previous.Priority) .. "->" .. tostring(state.Priority)
                    end
                    if previous.Looped ~= state.Looped then
                        changes[#changes + 1] = "Looped=" .. tostring(previous.Looped) .. "->" .. tostring(state.Looped)
                    end
                    if previous.TimePosition ~= state.TimePosition then
                        changes[#changes + 1] = "TimePosition=" .. tostring(previous.TimePosition) .. "->" .. tostring(state.TimePosition)
                    end
                    if previous.IsAnimationParented ~= state.IsAnimationParented then
                        changes[#changes + 1] = "AnimationParented=" .. tostring(previous.IsAnimationParented) .. "->" .. tostring(state.IsAnimationParented)
                    end
                    if #changes > 0 and state.Kind ~= "IDLE_TRACK" then
                        add(string.format("[%06.3fs] CHANGE %s | %s", now - started, tostring(state.Track), table.concat(changes, ", ")))
                    end
                end
                lastStates[track] = state
            end
        end
    end

    for track in pairs(previousTrackSet) do
        if not currentTrackSet[track] then
            local old = lastStates[track]
            if old and old.Kind ~= "IDLE_TRACK" then
                add(string.format("[%06.3fs] LOST_TRACK %s", now - started, describe(old)))
            end
        end
    end
    previousTrackSet = currentTrackSet

    if captureStarted and now - captureStarted >= 6 then
        if sourceEverDetected and sourceDetectedThisSample then
            finish("CAPTURE_COMPLETE_SOURCE_STILL_ACTIVE")
        else
            finish("CAPTURE_COMPLETE_SOURCE_ENDED_DURING_WINDOW")
        end
    end
end)
