--[[
    EVADE — PC/SOLARA EMOTE RUNTIME PROBE
    ================================================================
    Ejecutar en PC/Solara mientras se inicia un emote de Evade.

    Flujo:
      1) Presiona START PROBE.
      2) Inicia un emote normalmente dentro de Evade durante los 8 segundos.
      3) Espera a que termine la cuenta regresiva.
      4) El informe se copia automáticamente al portapapeles.

    Esta sonda es de solo lectura. No instala hooks, no reproduce ni detiene
    animaciones, no clona modelos, no dispara remotes y no modifica el avatar.
    Solo crea/limpia su propia GUI y conecta temporalmente listeners de lectura
    a AnimationPlayed; los listeners se desconectan al finalizar.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

local GUI_NAME = "YY_PC_Emote_Runtime_Probe"
local REPORT_FILE = "YY_PC_Emote_Runtime_Probe_Report.txt"
local PROBE_SECONDS = 8
local MAX_LINES = 2200

local lines = {}
local events = {}
local connections = {}
local lastResult = ""
local probing = false

local function add(value)
    if #lines < MAX_LINES then
        lines[#lines + 1] = tostring(value)
    end
end

local function safeCall(callback, fallback)
    local ok, result = pcall(callback)
    return ok and result or fallback
end

local function safeString(value, fallback)
    local ok, result = pcall(function() return tostring(value) end)
    return ok and result or (fallback or "<error>")
end

local function safeProperty(inst, property, fallback)
    if not inst then return fallback end
    return safeCall(function() return inst[property] end, fallback)
end

local function safeName(inst)
    return safeString(inst and safeProperty(inst, "Name", "<unnamed>") or "<nil>")
end

local function safeFullName(inst)
    if not inst then return "<nil>" end
    return safeCall(function() return inst:GetFullName() end, "<GetFullName error>")
end

local function safeClass(inst)
    return safeString(inst and safeProperty(inst, "ClassName", "<class unavailable>") or "<nil>")
end

local function clearConnections()
    for _, connection in ipairs(connections) do
        pcall(function() connection:Disconnect() end)
    end
    connections = {}
end

local function setClipboard(text)
    if type(setclipboard) == "function" then
        local ok = pcall(setclipboard, text)
        if ok then return true, "setclipboard" end
    end
    if type(toclipboard) == "function" then
        local ok = pcall(toclipboard, text)
        if ok then return true, "toclipboard" end
    end
    return false, "clipboard unavailable"
end

local function saveReport(text)
    if type(writefile) ~= "function" then return false end
    return pcall(writefile, REPORT_FILE, text)
end

local function findVisualRig()
    local rigs = workspace:FindFirstChild("Rigs")
    local rig = rigs and rigs:FindFirstChild(LocalPlayer.Name) or nil
    return rigs, rig
end

local function getAnimatorTargets()
    local targets = {}
    local seen = {}

    local function addAnimator(animator, label)
        if not animator or seen[animator] then return end
        seen[animator] = true
        targets[#targets + 1] = {Animator = animator, Label = label}
    end

    local rigs, rig = findVisualRig()
    local humanoid = rig and rig:FindFirstChildOfClass("Humanoid")
    local controller = rig and rig:FindFirstChildOfClass("AnimationController")
    addAnimator(humanoid and humanoid:FindFirstChildOfClass("Animator"), "VisualRig.Humanoid.Animator")
    addAnimator(controller and controller:FindFirstChildOfClass("Animator"), "VisualRig.AnimationController.Animator")

    local character = LocalPlayer and LocalPlayer.Character
    local characterHumanoid = character and character:FindFirstChildOfClass("Humanoid")
    addAnimator(characterHumanoid and characterHumanoid:FindFirstChildOfClass("Animator"), "Character.Humanoid.Animator")

    return targets, rigs, rig
end

local function describeTrack(track)
    local animation = safeProperty(track, "Animation", nil)
    local animationId = animation and safeProperty(animation, "AnimationId", "<missing>") or "<missing>"
    return string.format(
        "Name=%s AnimationId=%s Priority=%s Looped=%s IsPlaying=%s Speed=%s TimePosition=%s Length=%s WeightCurrent=%s",
        safeString(safeProperty(track, "Name", "<missing>")),
        safeString(animationId),
        safeString(safeProperty(track, "Priority", "<unavailable>")),
        safeString(safeProperty(track, "Looped", "<unavailable>")),
        safeString(safeProperty(track, "IsPlaying", "<unavailable>")),
        safeString(safeProperty(track, "Speed", "<unavailable>")),
        safeString(safeProperty(track, "TimePosition", "<unavailable>")),
        safeString(safeProperty(track, "Length", "<unavailable>")),
        safeString(safeProperty(track, "WeightCurrent", "<unavailable>"))
    )
end

local function recordTrackEvent(label, track, source)
    local animation = safeProperty(track, "Animation", nil)
    local animationId = animation and safeProperty(animation, "AnimationId", "<missing>") or "<missing>"
    events[#events + 1] = {
        Time = os.clock(),
        Source = source,
        Label = label,
        Track = safeString(safeProperty(track, "Name", "<missing>")),
        AnimationId = safeString(animationId),
        Description = describeTrack(track),
    }
end

local function findSpeedChangeCandidates()
    local result = {
        getgcAvailable = type(getgc) == "function",
        hookfunctionAvailable = type(hookfunction) == "function",
        candidateCount = nil,
        candidates = {},
    }
    if not result.getgcAvailable then
        return result
    end

    local ok, gcTable = pcall(getgc, true)
    if not ok or type(gcTable) ~= "table" then
        return result
    end

    local seen = {}
    local count = 0
    for _, value in ipairs(gcTable) do
        if type(value) == "table" and not seen[value] then
            local okFunction, speedChange = pcall(function()
                return rawget(value, "SpeedChange")
            end)
            if okFunction and type(speedChange) == "function" then
                seen[value] = true
                count = count + 1
                if #result.candidates < 25 then
                    result.candidates[#result.candidates + 1] = {
                        Table = safeString(value),
                        Function = safeString(speedChange),
                    }
                end
            end
        end
    end
    result.candidateCount = count
    return result
end

local function writeHeader()
    add("YY PC/SOLARA EMOTE RUNTIME PROBE")
    add("Timestamp=" .. os.date("!%Y-%m-%dT%H:%M:%SZ"))
    add("ReadOnly=true")
    add("ProbeSeconds=" .. tostring(PROBE_SECONDS))
    add("")
end

local function scanStaticContext()
    add("===== EXECUTOR CAPABILITIES =====")
    add("setclipboard=" .. tostring(type(setclipboard) == "function"))
    add("toclipboard=" .. tostring(type(toclipboard) == "function"))
    add("writefile=" .. tostring(type(writefile) == "function"))
    add("gethui=" .. tostring(type(gethui) == "function"))
    add("getgc=" .. tostring(type(getgc) == "function"))
    add("hookfunction=" .. tostring(type(hookfunction) == "function"))
    add("getconnections=" .. tostring(type(getconnections) == "function"))
    add("")

    add("===== GAME / CHARACTER =====")
    add("PlaceId=" .. safeString(game.PlaceId))
    add("JobId=" .. safeString(game.JobId))
    add("LocalPlayer=" .. safeString(LocalPlayer and LocalPlayer.Name or "<nil>"))
    add("LocalUserId=" .. safeString(LocalPlayer and LocalPlayer.UserId or "<nil>"))
    add("Character=" .. safeFullName(LocalPlayer and LocalPlayer.Character or nil))
    add("VisualRigs=" .. safeFullName(workspace:FindFirstChild("Rigs")))
    add("")

    local speedInfo = findSpeedChangeCandidates()
    add("===== SPEEDCHANGE DISCOVERY (NO HOOK INSTALLED) =====")
    add("getgcAvailable=" .. tostring(speedInfo.getgcAvailable))
    add("hookfunctionAvailable=" .. tostring(speedInfo.hookfunctionAvailable))
    add("SpeedChangeCandidateCount=" .. safeString(speedInfo.candidateCount, "<unavailable>"))
    for index, candidate in ipairs(speedInfo.candidates) do
        add("SpeedChangeCandidate[" .. tostring(index) .. "] table=" .. candidate.Table .. " function=" .. candidate.Function)
    end
    add("")
end

local function scanAnimatorSnapshot(targets, label)
    add("===== " .. label .. " SNAPSHOT =====")
    if #targets == 0 then
        add("AnimatorTargets=<none>")
        add("")
        return
    end

    for _, target in ipairs(targets) do
        add(target.Label .. "=" .. safeFullName(target.Animator))
        local tracks = safeCall(function() return target.Animator:GetPlayingAnimationTracks() end, nil)
        if not tracks then
            add(target.Label .. ".GetPlayingAnimationTracks=<error>")
        else
            add(target.Label .. ".PlayingTracks=" .. tostring(#tracks))
            for index, track in ipairs(tracks) do
                if index > 80 then
                    add(target.Label .. ".TRACKS_TRUNCATED=true")
                    break
                end
                add(target.Label .. ".TRACK[" .. tostring(index) .. "] " .. describeTrack(track))
            end
        end
    end
    add("")
end

local function scanEventSummary()
    add("===== ANIMATIONPLAYED EVENTS CAPTURED =====")
    add("EventCount=" .. tostring(#events))
    for index, event in ipairs(events) do
        add(string.format(
            "EVENT[%d] t=%.3f Source=%s Label=%s Track=%s AnimationId=%s Details={%s}",
            index,
            event.Time,
            event.Source,
            event.Label,
            event.Track,
            event.AnimationId,
            event.Description
        ))
    end
    if #events == 0 then
        add("WARNING: no AnimationPlayed event was captured during the probe")
    end
    add("")
end

local function runProbe(update)
    if probing then return nil, "PROBE_ALREADY_RUNNING" end
    probing = true
    lines = {}
    events = {}
    clearConnections()

    writeHeader()
    scanStaticContext()
    local targets = getAnimatorTargets()
    scanAnimatorSnapshot(targets, "BEFORE")

    for _, target in ipairs(targets) do
        local connection = target.Animator.AnimationPlayed:Connect(function(track)
            recordTrackEvent(target.Label, track, "AnimationPlayed")
        end)
        connections[#connections + 1] = connection
    end

    for second = 1, PROBE_SECONDS do
        update("Probe active • " .. tostring(PROBE_SECONDS - second + 1) .. "s remaining")
        task.wait(1)
    end

    clearConnections()
    scanAnimatorSnapshot(getAnimatorTargets(), "AFTER")
    scanEventSummary()
    add("InterpretationHint=If only Idle appears and EventCount=0, run the probe while starting an Evade emote; if events appear only on Character.Animator, the PC hook is observing the wrong rig.")
    add("InterpretationHint=If an emote event appears but SpeedChangeCandidateCount is 0 or hookfunctionAvailable=false, inEvadeEmote may never become true in the current PC implementation.")
    add("")
    add("TRUNCATED=" .. tostring(#lines >= MAX_LINES))
    add("END_REPORT")

    lastResult = table.concat(lines, "\n")
    local copied, method = setClipboard(lastResult)
    local saved = saveReport(lastResult)
    probing = false
    return lastResult, copied, method, saved
end

local function getGuiParent()
    local parent = nil
    if type(gethui) == "function" then
        parent = safeCall(function() return gethui() end, nil)
    end
    if not parent then
        parent = safeCall(function() return game:GetService("CoreGui") end, nil)
    end
    if not parent and LocalPlayer then
        parent = safeCall(function() return LocalPlayer:WaitForChild("PlayerGui") end, nil)
    end
    return parent
end

