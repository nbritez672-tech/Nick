    instruction.Position = UDim2.fromOffset(14, 50)
    instruction.Size = UDim2.new(1, -28, 0, 30)
    instruction.Font = Enum.Font.Gotham
    instruction.Text = "Press START, then start an Evade emote during the 8-second window."
    instruction.TextColor3 = Color3.fromRGB(170, 170, 180)
    instruction.TextSize = 10
