local function scanAnimator(animator, label)
    if not animator then
        add(label .. "=<missing>")
        return
    end

    add(label .. "=" .. safeFullName(animator) .. " [" .. safeClass(animator) .. "]")
    add(label .. ".Parent=" .. safeFullName(animator.Parent))
    add(label .. ".Descendants=" .. tostring(countDescendants(animator)))

    local tracks = safeCall(function() return animator:GetPlayingAnimationTracks() end, nil)
    if not tracks then
        add(label .. ".GetPlayingAnimationTracks=<error>")
        return
    end

    add(label .. ".PlayingTracks=" .. tostring(#tracks))
    for index, track in ipairs(tracks) do
        if index > 80 then
            add(label .. ".TRUNCATED_TRACKS=true")
            break
        end
        local animation = safeProperty(track, "Animation", nil)
        local animationId = animation and safeProperty(animation, "AnimationId", "<missing>") or "<missing>"
        add(string.format(
            "%s.TRACK[%d] Name=%s AnimationId=%s Priority=%s Looped=%s IsPlaying=%s Speed=%s TimePosition=%s Length=%s Weight=%s",
            label,
            index,
            safeString(safeProperty(track, "Name", "<missing>")),
            safeString(animationId),
            safeString(safeProperty(track, "Priority", "<unavailable>")),
            safeString(safeProperty(track, "Looped", "<unavailable>")),
            safeString(safeProperty(track, "IsPlaying", "<unavailable>")),
            safeString(safeProperty(track, "Speed", "<unavailable>")),
            safeString(safeProperty(track, "TimePosition", "<unavailable>")),
            safeString(safeProperty(track, "Length", "<unavailable>")),
            safeString(safeProperty(track, "WeightCurrent", "<unavailable>"))
        ))
    end
end

local function scanVisualRig()
    add("===== VISUAL RIG / ANIMATION ROUTES =====")
    local rigs = workspace:FindFirstChild("Rigs")
    add("workspace.Rigs=" .. safeFullName(rigs))
    if not rigs then
        add("ERROR: workspace.Rigs missing")
        add("")
        return
    end

    local rig = rigs:FindFirstChild(LocalPlayer.Name)
    add("workspace.Rigs." .. LocalPlayer.Name .. "=" .. safeFullName(rig))
    if not rig then
        add("ERROR: local visual rig missing")
        add("")
        return
    end

    add("Rig.Class=" .. safeClass(rig))
    add("Rig.Descendants=" .. tostring(countDescendants(rig)))
    add("Rig.PrimaryPart=" .. safeFullName(safeProperty(rig, "PrimaryPart", nil)))
    add("Rig.Humanoid=" .. safeFullName(rig:FindFirstChildOfClass("Humanoid")))
    add("Rig.AnimationController=" .. safeFullName(rig:FindFirstChildOfClass("AnimationController")))

    local humanoid = rig:FindFirstChildOfClass("Humanoid")
    local controller = rig:FindFirstChildOfClass("AnimationController")
    local humanoidAnimator = humanoid and humanoid:FindFirstChildOfClass("Animator")
    local controllerAnimator = controller and controller:FindFirstChildOfClass("Animator")

    add("Humanoid.RigType=" .. safeString(humanoid and safeProperty(humanoid, "RigType", "<unavailable>") or "<missing>"))
    add("Humanoid.Health=" .. safeString(humanoid and safeProperty(humanoid, "Health", "<unavailable>") or "<missing>"))
    scanAnimator(humanoidAnimator, "Rig.Humanoid.Animator")
    scanAnimator(controllerAnimator, "Rig.AnimationController.Animator")

    local expectedParts = {
        "HumanoidRootPart", "Head", "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg",
    }
    add("===== EXPECTED R6 PARTS =====")
    for _, partName in ipairs(expectedParts) do
        local part = rig:FindFirstChild(partName, true)
        add(partName .. "=" .. safeFullName(part) .. " [" .. safeClass(part) .. "]")
    end
    add("")
end

local TARGET_EMOTE_NAMES = {
    "RockinStride", "ZombieStride", "GhoulishGalleon", "Griddy", "BananaDance",
    "OiiaOiia", "Writhing", "AstroSlide", "Popular", "Moonwalk", "Golpeador",
    "HeadlessBaller", "Banger", "Broom", "BoldMarch",
}

local function appendTreeSummary(root, maxNodes)
    if not root then return end
    local nodes = root:GetDescendants()
    local limit = math.min(#nodes, maxNodes or 160)
    for index = 1, limit do
        local inst = nodes[index]
        local line = string.format(
            "TREE[%d] %s [%s] Archivable=%s",
            index,
            safePath(inst, root),
            safeClass(inst),
            safeBool(inst, "Archivable")
        )
        if inst:IsA("Animation") then
            line = line .. " AnimationId=" .. safeString(safeProperty(inst, "AnimationId", "<unavailable>"))
        elseif inst:IsA("Sound") then
            line = line .. " SoundId=" .. safeString(safeProperty(inst, "SoundId", "<unavailable>"))
        elseif inst:IsA("BasePart") then
            line = line .. " Size=" .. formatVector(safeProperty(inst, "Size", nil))
        elseif inst:IsA("Motor6D") or inst:IsA("Weld") or inst:IsA("WeldConstraint") then
            line = line
                .. " Part0=" .. safeFullName(safeProperty(inst, "Part0", nil))
                .. " Part1=" .. safeFullName(safeProperty(inst, "Part1", nil))
        end
        add(line)
    end
    if #nodes > limit then
        add("TREE_TRUNCATED=true total=" .. tostring(#nodes) .. " shown=" .. tostring(limit))
    end
end

local function scanEmoteModules()
    add("===== EMOTE MODULE DISCOVERY =====")
    local items = ReplicatedStorage:FindFirstChild("Items")
    add("ReplicatedStorage.Items=" .. safeFullName(items))
    if not items then
        add("ERROR: ReplicatedStorage.Items missing")
        add("")
        return
    end

    local roots = {}
    local packs = items:FindFirstChild("ItemPacks")
    local baseItems = items:FindFirstChild("BaseItems")
    if packs then roots[#roots + 1] = packs end
    if baseItems then roots[#roots + 1] = baseItems end
    add("ScanRoots=" .. tostring(#roots))
    add("ItemPacks=" .. safeFullName(packs))
    add("BaseItems=" .. safeFullName(baseItems))

    local foundByPath = {}
    for _, root in ipairs(roots) do
        for _, inst in ipairs(root:GetDescendants()) do
            if inst:IsA("ModuleScript") then
                local name = safeName(inst)
                local lowered = string.lower(name)
                local explicit = false
                for _, target in ipairs(TARGET_EMOTE_NAMES) do
                    if name == target then
                        explicit = true
                        break
                    end
                end
                if explicit or string.find(lowered, "emote", 1, true) then
                    local path = safeFullName(inst)
                    if not foundByPath[path] then
                        foundByPath[path] = true
                        add("MODULE name=" .. name .. " path=" .. path)
                        add("MODULE.CharacterClassic=" .. safeFullName(inst:FindFirstChild("CharacterClassic")))
                        local classic = inst:FindFirstChild("CharacterClassic")
                        local emoteModel = classic and classic:FindFirstChild("EmoteModel")
                        add("MODULE.EmoteModel=" .. safeFullName(emoteModel))
                        add("MODULE.ModuleChildren=" .. tostring(#inst:GetChildren()))
                        if classic then
                            add("MODULE.CharacterClassicChildren=" .. tostring(#classic:GetChildren()))
                            add("MODULE.CharacterClassicDescendants=" .. tostring(countDescendants(classic)))
                        end
                        if emoteModel then
                            add("MODULE.EmoteModelChildren=" .. tostring(#emoteModel:GetChildren()))
                            add("MODULE.EmoteModelDescendants=" .. tostring(countDescendants(emoteModel)))
                            add("MODULE.EmoteModel.PrimaryPart=" .. safeFullName(safeProperty(emoteModel, "PrimaryPart", nil)))
                            add("MODULE.EmoteModel.Pivot=" .. formatCFrame(safeCall(function() return emoteModel:GetPivot() end, nil)))
                            appendTreeSummary(emoteModel, 220)
                        end
                        add("")
                    end
                end
            end
        end
    end

    local totalFound = 0
    for _ in pairs(foundByPath) do totalFound = totalFound + 1 end
    add("EmoteModuleMatches=" .. tostring(totalFound))
    if totalFound == 0 then
        add("WARNING: no configured emote ModuleScript was found in ItemPacks/BaseItems")
    end
    add("")
end

local function scanRuntimeSoundRoute()
    add("===== EMOTE SOUND ROUTE =====")
    local playersFolder = workspace:FindFirstChild("Players")
    add("workspace.Players=" .. safeFullName(playersFolder))
    local charModel = playersFolder and playersFolder:FindFirstChild(LocalPlayer.Name)
    add("workspace.Players.LocalPlayerModel=" .. safeFullName(charModel))
    local hrp = charModel and charModel:FindFirstChild("HumanoidRootPart")
    local soundPos = hrp and hrp:FindFirstChild("SoundPos")
    add("SoundPos=" .. safeFullName(soundPos))
    if soundPos then
        local sounds = soundPos:GetChildren()
        add("SoundPos.Children=" .. tostring(#sounds))
        for _, inst in ipairs(sounds) do
            if inst:IsA("Sound") then
                add("SOUND name=" .. safeName(inst)
                    .. " SoundId=" .. safeString(safeProperty(inst, "SoundId", "<unavailable>"))
                    .. " IsPlaying=" .. safeString(safeProperty(inst, "IsPlaying", "<unavailable>"))
                    .. " Volume=" .. safeString(safeProperty(inst, "Volume", "<unavailable>")))
            end
        end
    else
        add("WARNING: SoundPos not found")
    end
    add("")
end

local function scanRelevantEvents()
    add("===== RELEVANT EVENT STRUCTURES =====")
    local events = ReplicatedStorage:FindFirstChild("Events")
    local services = ReplicatedStorage:FindFirstChild("Services")
    add("ReplicatedStorage.Events=" .. safeFullName(events))
    add("ReplicatedStorage.Services=" .. safeFullName(services))
    if events then
        for _, inst in ipairs(events:GetChildren()) do
            local lowered = string.lower(safeName(inst))
            if string.find(lowered, "emote", 1, true)
            or string.find(lowered, "anim", 1, true)
            or string.find(lowered, "sound", 1, true) then
                add("EVENT " .. safeFullName(inst) .. " [" .. safeClass(inst) .. "]")
            end
        end
    end
    if services then
        local data = services:FindFirstChild("Data")
        local registry = data and data:FindFirstChild("ServerStateRegistryService")
        add("ServerStateRegistryService=" .. safeFullName(registry))
        if registry then
            add("Registry.ChangedEvent=" .. safeFullName(registry:FindFirstChild("ChangedEvent")))
        end
    end
    add("")
end

local function scanCurrentCharacter()
    add("===== LOCAL CHARACTER CONTEXT =====")
    local char = LocalPlayer and LocalPlayer.Character
    add("LocalPlayer.Character=" .. safeFullName(char))
    if char then
        add("Character.Class=" .. safeClass(char))
        add("Character.Descendants=" .. tostring(countDescendants(char)))
        add("Character.Humanoid=" .. safeFullName(char:FindFirstChildOfClass("Humanoid")))
        add("Character.Animator=" .. safeFullName(char:FindFirstChildOfClass("Humanoid") and char:FindFirstChildOfClass("Humanoid"):FindFirstChildOfClass("Animator")))
    end
    add("")
end

local function runScan()
    if scanRunning then return "SCAN_ALREADY_RUNNING" end
    scanRunning = true
    lines = {}

    add("YY PC/SOLARA EMOTE DIAGNOSTIC REPORT")
    add("Timestamp=" .. os.date("!%Y-%m-%dT%H:%M:%SZ"))
    add("ReadOnly=true")
    add("")

    local ok, err = pcall(function()
        scanExecutorCapabilities()
        scanGameContext()
        scanCurrentCharacter()
        scanVisualRig()
        scanEmoteModules()
        scanRuntimeSoundRoute()
        scanRelevantEvents()
    end)
    if not ok then
        add("FATAL_SCAN_ERROR=" .. safeString(err))
    end

    if #lines >= MAX_LINES then
        add("TRUNCATED=true MAX_LINES=" .. tostring(MAX_LINES))
    else
        add("TRUNCATED=false")
    end
    add("")
    add("END_REPORT")

    lastResult = table.concat(lines, "\n")
    local copied, copyMethod = setClipboard(lastResult)
    local saved = saveReport(lastResult)
    scanRunning = false

    return lastResult, copied, copyMethod, saved
end

