--[[
    EVADE — PC/SOLARA EMOTE DIAGNOSTIC SCANNER
    ================================================================
    Scanner independiente y de solo lectura para diagnosticar por qué
    la sustitución visual de emotes funciona en celular pero no en PC.

    El scanner:
      * Inspecciona los Animator/AnimationController del rig visual.
      * Lista AnimationTracks activos, IDs, prioridades y estados.
      * Busca los ModuleScripts de emotes en Items.ItemPacks/BaseItems.
      * Verifica CharacterClassic, EmoteModel y árboles de props.
      * Revisa la ruta del sonido EmoteSound en Workspace.Players.
      * Comprueba capacidades básicas del entorno Solara.
      * Muestra el informe en una GUI independiente.
      * Copia automáticamente el informe con setclipboard si existe.

    No clona, no destruye, no reproduce emotes, no dispara remotes y no
    modifica el juego. Solo elimina una GUI anterior con su propio nombre.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

local GUI_NAME = "YY_PC_Emote_Diagnostic_Scanner"
local REPORT_FILE = "YY_PC_Emote_Diagnostic_Report.txt"
local MAX_LINES = 3200
local lines = {}
local lastResult = ""
local scanRunning = false

local function add(value)
    if #lines < MAX_LINES then
        lines[#lines + 1] = tostring(value)
    end
end

local function safeCall(callback, fallback)
    local ok, result = pcall(callback)
    if ok then
        return result
    end
    return fallback
end

local function safeString(value, fallback)
    local ok, result = pcall(function()
        return tostring(value)
    end)
    return ok and result or (fallback or "<error>")
end

local function safeClass(inst)
    if not inst then return "<nil>" end
    return safeCall(function() return inst.ClassName end, "<ClassName error>")
end

local function safeName(inst)
    if not inst then return "<nil>" end
    return safeCall(function() return inst.Name end, "<Name error>")
end

local function safeFullName(inst)
    if not inst then return "<nil>" end
    return safeCall(function() return inst:GetFullName() end, "<GetFullName error>")
end

local function safeProperty(inst, property, fallback)
    if not inst then return fallback end
    return safeCall(function() return inst[property] end, fallback)
end

local function safeBool(inst, property)
    local value = safeProperty(inst, property, nil)
    if value == nil then return "<unavailable>" end
    return tostring(value)
end

local function safePath(inst, root)
    if not inst or not root then return "<nil>" end
    local full = safeFullName(inst)
    local rootFull = safeFullName(root)
    local prefix = rootFull .. "."
    if full:sub(1, #prefix) == prefix then
        return full:sub(#prefix + 1)
    end
    return full
end

local function getExecutorParent()
    local parent = nil
    if type(gethui) == "function" then
        parent = safeCall(function() return gethui() end, nil)
    end
    if not parent then
        parent = safeCall(function() return game:GetService("CoreGui") end, nil)
    end
    if not parent and LocalPlayer then
        parent = safeCall(function() return LocalPlayer:WaitForChild("PlayerGui") end, nil)
    end
    return parent
end

local function setClipboard(text)
    if type(setclipboard) == "function" then
        local ok = pcall(setclipboard, text)
        if ok then return true, "setclipboard" end
    end
    if type(toclipboard) == "function" then
        local ok = pcall(toclipboard, text)
        if ok then return true, "toclipboard" end
    end
    return false, "clipboard function unavailable"
end

local function saveReport(text)
    if type(writefile) == "function" then
        local ok = pcall(writefile, REPORT_FILE, text)
        if ok then return true end
    end
    return false
end

local function countDescendants(inst)
    if not inst then return 0 end
    return safeCall(function() return #inst:GetDescendants() end, 0)
end

local function formatVector(value)
    if typeof(value) ~= "Vector3" then return "<not Vector3>" end
    return string.format("(%.3f, %.3f, %.3f)", value.X, value.Y, value.Z)
end

local function formatCFrame(value)
    if typeof(value) ~= "CFrame" then return "<not CFrame>" end
    local position = value.Position
    local x, y, z = value:ToOrientation()
    return string.format(
        "pos=(%.3f, %.3f, %.3f) rot=(%.3f, %.3f, %.3f)",
        position.X, position.Y, position.Z, x, y, z
    )
end

