    status.TextSize = 10
    status.TextXAlignment = Enum.TextXAlignment.Left
    status.Parent = panel

    local function button(name, text, x, width)
        local b = Instance.new("TextButton")
        b.Name = name
        b.Position = UDim2.new(1, x, 1, -58)
        b.Size = UDim2.fromOffset(width, 32)
        b.BackgroundColor3 = Color3.fromRGB(52, 52, 65)
        b.BorderSizePixel = 0
        b.AutoButtonColor = false
        b.Font = Enum.Font.GothamBold
        b.Text = text
        b.TextColor3 = Color3.fromRGB(245, 245, 250)
        b.TextSize = 10
        b.Parent = panel
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, 8)
        c.Parent = b
        return b
    end

    local start = button("Start", "START PROBE", -249, 94)
    local copy = button("Copy", "COPY", -149, 70)
    local clear = button("Clear", "CLEAR", -69, 59)

    local function setStatus(text, color)
        status.Text = text
        status.TextColor3 = color or Color3.fromRGB(165, 165, 175)
    end

    start.MouseButton1Click:Connect(function()
        if probing then return end
        setStatus("Running probe...", Color3.fromRGB(245, 220, 130))
        task.spawn(function()
            local result, copied, method, saved = runProbe(function(text)
                setStatus(text, Color3.fromRGB(245, 220, 130))
            end)
            output.Text = result or "<probe failed>"
            local copyText = copied and ("copied via " .. tostring(method)) or "clipboard unavailable"
            local fileText = saved and "file saved" or "file not saved"
            setStatus("Done • " .. copyText .. " • " .. fileText, copied and Color3.fromRGB(145, 255, 180) or Color3.fromRGB(255, 180, 135))
        end)
    end)

    copy.MouseButton1Click:Connect(function()
        if lastResult == "" then
            setStatus("Run START PROBE first", Color3.fromRGB(255, 190, 130))
            return
        end
        local copied, method = setClipboard(lastResult)
        setStatus(copied and ("Copied via " .. tostring(method)) or "Clipboard unavailable", copied and Color3.fromRGB(145, 255, 180) or Color3.fromRGB(255, 180, 135))
    end)

    clear.MouseButton1Click:Connect(function()
        output.Text = "Press START PROBE to begin."
        lastResult = ""
        setStatus("Cleared")
    end)

    close.MouseButton1Click:Connect(function()
        clearConnections()
        pcall(function() gui:Destroy() end)
    end)

    local dragging = false
    local dragStart = nil
    local startPosition = nil
    top.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPosition = panel.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
        and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        local delta = input.Position - dragStart
        panel.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end)

    return gui
end

local gui = createGui()
if gui then
    print("[YY PC Emote Probe] GUI loaded. Press START PROBE.")
else
    local result, copied, method, saved = runProbe(function() end)
    print(result)
    print("[YY PC Emote Probe] copied=" .. tostring(copied) .. " method=" .. tostring(method) .. " saved=" .. tostring(saved))
end
