local function trim(value)
    return tostring(value or ""):gsub("^%s+", ""):gsub("%s+$", "")
end

local function getGuiParent()
    local parent
    pcall(function()
        if type(gethui) == "function" then
            parent = gethui()
        end
    end)
    if parent then
        return parent
    end

    pcall(function()
        parent = game:GetService("CoreGui")
    end)
    return parent or LocalPlayer:WaitForChild("PlayerGui")
end

local guiParent = getGuiParent()
local oldGui = guiParent:FindFirstChild("YY_VisualEmoteChanger")
if oldGui then
    oldGui:Destroy()
end

local function findFolderByName(name)
    name = trim(name)
    if name == "" then
        return nil
    end

    local exact = ReplicatedStorage:FindFirstChild(name, true)
    if exact then
        return exact
    end

    local lowered = string.lower(name)
    for _, inst in ipairs(ReplicatedStorage:GetDescendants()) do
        if string.lower(inst.Name) == lowered then
            return inst
        end
    end

    return nil
end

local function destroyList(list)
    for _, inst in ipairs(list) do
        pcall(function()
            inst:Destroy()
        end)
    end
end

local function replaceEmote(targetName, sourceName)
    targetName = trim(targetName)
    sourceName = trim(sourceName)

    if targetName == "" or sourceName == "" then
        return false, "Completa los dos campos antes de aplicar."
    end

    local targetFolder = findFolderByName(targetName)
    if not targetFolder then
        return false, "No se encontró el emote objetivo: " .. targetName
    end

    local sourceFolder = findFolderByName(sourceName)
    if not sourceFolder then
        return false, "No se encontró el emote fuente: " .. sourceName
    end

    if targetFolder == sourceFolder then
        return false, "El emote objetivo y el emote fuente no pueden ser iguales."
    end

    -- Preparar todos los clones antes de borrar el objetivo. Si algún hijo no
    -- puede clonarse, se cancela la operación y se conserva el emote original.
    local stagedClones = {}
    for _, item in ipairs(sourceFolder:GetChildren()) do
        local ok, clonedItem = pcall(function()
            return item:Clone()
        end)
        if not ok or not clonedItem then
            destroyList(stagedClones)
            return false, "No se pudo clonar el elemento: " .. item.Name
        end
        stagedClones[#stagedClones + 1] = clonedItem
    end

    for _, item in ipairs(targetFolder:GetChildren()) do
        pcall(function()
            item:Destroy()
        end)
    end

    local parentErrors = {}
    for _, clonedItem in ipairs(stagedClones) do
        local ok, err = pcall(function()
            clonedItem.Parent = targetFolder
        end)
        if not ok then
            parentErrors[#parentErrors + 1] = tostring(err)
            pcall(function()
                clonedItem:Destroy()
            end)
        end
    end

    if #parentErrors > 0 then
        return false, "No se pudieron insertar todos los elementos del emote fuente."
    end

    return true, "Emote aplicado: " .. targetName .. " ← " .. sourceName
end

