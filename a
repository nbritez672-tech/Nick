for i, emote in ipairs(EMOTES) do
    if emote.animId ~= "" then  -- solo mostrar emotes con ID válido
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -8, 0, 38)
        btn.BackgroundColor3 = Color3.fromRGB(28, 28, 42)
        btn.BorderSizePixel = 0
        btn.Text = emote.label
        btn.Font = Enum.Font.Gotham
        btn.TextSize = 12
        btn.TextColor3 = Color3.fromRGB(190, 190, 215)
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.LayoutOrder = i
        btn.Parent = scroll
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

        local btnPad = Instance.new("UIPadding")
        btnPad.PaddingLeft = UDim.new(0, 12)
        btnPad.Parent = btn

        btn.MouseButton1Click:Connect(function()
            if activeVisualTrack or activeSourceTrack then
                invalidateAndCleanup()
            end
            if activeBtn and activeBtn ~= btn then
                activeBtn.BackgroundColor3 = Color3.fromRGB(28, 28, 42)
                activeBtn.TextColor3 = Color3.fromRGB(190, 190, 215)
            end
            if State.emoteIdx == i then
                -- Deseleccionar
                State.emoteIdx = nil
                activeBtn = nil
                btn.BackgroundColor3 = Color3.fromRGB(28, 28, 42)
                btn.TextColor3 = Color3.fromRGB(190, 190, 215)
                invalidateAndCleanup()
            else
                State.emoteIdx = i
                activeBtn = btn
                btn.BackgroundColor3 = Color3.fromRGB(34, 160, 80)
                btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            end
        end)
    end
end

-- Drag
local dragging, dragStart, startPos = false, nil, nil
frame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch
    or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = frame.Position
    end
end)
frame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch
    or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)
game:GetService("UserInputService").InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.Touch
    or input.UserInputType == Enum.UserInputType.MouseMove) then
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

