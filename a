local function createInput(name, placeholder, position)
    local input = Instance.new("TextBox")
    input.Name = name
    input.ClearTextOnFocus = false
    input.MultiLine = false
    input.BackgroundColor3 = Color3.fromRGB(25, 28, 43)
    input.BorderSizePixel = 0
    input.Position = position
    input.Size = UDim2.new(1, -36, 0, 42)
    input.Font = Enum.Font.Gotham
    input.PlaceholderText = placeholder
    input.PlaceholderColor3 = Color3.fromRGB(112, 120, 149)
    input.Text = ""
    input.TextColor3 = Color3.fromRGB(240, 243, 255)
    input.TextSize = 12
    input.TextXAlignment = Enum.TextXAlignment.Left
    input.Parent = frame

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 9)
    corner.Parent = input

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(67, 75, 110)
    stroke.Transparency = 0.25
    stroke.Thickness = 1
    stroke.Parent = input

    local padding = Instance.new("UIPadding")
    padding.PaddingLeft = UDim.new(0, 13)
    padding.PaddingRight = UDim.new(0, 13)
    padding.Parent = input

    input.Focused:Connect(function()
        TweenService:Create(stroke, TweenInfo.new(0.15), {
            Color = Color3.fromRGB(126, 145, 255),
            Transparency = 0,
        }):Play()
    end)
    input.FocusLost:Connect(function()
        TweenService:Create(stroke, TweenInfo.new(0.15), {
            Color = Color3.fromRGB(67, 75, 110),
            Transparency = 0.25,
        }):Play()
    end)

    return input
end

